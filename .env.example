# Variáveis do app. Em desenvolvimento: copie para .env. No docker-compose:
# o mesmo .env serve, e o compose monta o DATABASE_URL do Postgres dele.

# Banco PostgreSQL (obrigatório). No docker-compose é ignorado.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/takeops?schema=public"

# Segredo das sessões, 32+ caracteres (obrigatório em produção).
# Gere com: npx auth secret
AUTH_SECRET="gere com openssl rand -base64 32"

# URL pública do app em produção, ex.: https://takeops.exemplo.com
# AUTH_URL=""

# Login. Configure ao menos um método em produção; cada um só liga
# com as duas variáveis preenchidas.

# Google OAuth. Redirect: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Link por e-mail (SMTP). Ex.: smtps://usuario:senha@smtp.exemplo.com:465
EMAIL_SERVER=""
# Remetente, ex.: TakeOps <takeops@exemplo.com>
EMAIL_FROM=""

# E-mail de contato das páginas /privacidade e /termos (opcional). Sem ele,
# as páginas mandam falar com quem administra a instância.
# LEGAL_CONTACT_EMAIL=""

# Segredo da rota de avisos agendados, 32+ caracteres (opcional).
# Sem ele a rota responde 404. No docker-compose o serviço `cron` já chama
# de hora em hora; fora dele, agende:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" <AUTH_URL>/api/cron/upcoming-shoots
# CRON_SECRET=""

# Aplica migrations ao subir a imagem Docker (padrão true).
# MIGRATE_ON_START=true

# --- Só docker-compose ---

# Senha do Postgres do compose (obrigatória lá). Use só letras e números,
# porque ela entra na URL do banco. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=""

# Porta publicada no host (padrão 3000).
# APP_PORT=3000

# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/takeops_shadow?schema=public"
