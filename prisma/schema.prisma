generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  memberships     WorkspaceMember[]
  invitesSent     WorkspaceInvite[] @relation("InviteInviter")
  invitesAccepted WorkspaceInvite[] @relation("InviteAccepter")
  ideas           Idea[]
  projectsCreated VideoProject[] @relation("ProjectCreator")
  projectsOwned   VideoProject[] @relation("ProjectOwner")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  logoUrl   String?
  timezone  String            @default("America/Cuiaba")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  ideas     Idea[]
  projects  VideoProject[]
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model WorkspaceInvite {
  id           String       @id @default(uuid())
  workspaceId  String
  email        String
  role         WorkspaceRole
  tokenHash    String       @unique
  status       InviteStatus @default(PENDING)
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation("InviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email, status])
}

enum IdeaFormat {
  TUTORIAL
  SKETCH
  DEMO
  FEATURE
  INSTITUTIONAL
  EDUCATIONAL
  BEHIND_THE_SCENES
  OTHER
}

enum IdeaStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  DISCARDED
  CONVERTED
}

model Idea {
  id           String      @id @default(uuid())
  workspaceId  String
  title        String
  description  String?
  format       IdeaFormat?
  objective    String?
  product      String?
  audience     String?
  referenceUrl String?
  notes        String?
  authorId     String
  status       IdeaStatus  @default(NEW)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  projects     VideoProject[]

  @@index([workspaceId, createdAt])
}

enum VideoProjectStatus {
  IDEA
  PRE_PRODUCTION
  SCRIPTING
  READY_TO_RECORD
  RECORDING
  EDITING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AspectRatio {
  NINE_SIXTEEN
  SIXTEEN_NINE
  ONE_ONE
  FOUR_FIVE
}

model VideoProject {
  id                        String             @id @default(uuid())
  workspaceId               String
  title                     String
  slug                      String?
  description               String?
  objective                 String?
  audience                  String?
  product                   String?
  format                    IdeaFormat
  aspectRatio               AspectRatio        @default(NINE_SIXTEEN)
  estimatedDurationSeconds  Int?
  status                    VideoProjectStatus @default(IDEA)
  priority                  ProjectPriority    @default(NORMAL)
  thumbnailUrl              String?
  ownerId                   String?
  plannedShootDate          DateTime?
  plannedPublishDate        DateTime?
  sourceIdeaId              String?
  createdById               String
  deletedAt                 DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  workspace                 Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy                 User               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  owner                     User?              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sourceIdea                Idea?              @relation(fields: [sourceIdeaId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
