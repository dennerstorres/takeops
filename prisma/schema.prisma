generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  // Idioma escolhido pelo usuário (ADR-041). Nulo: segue o navegador.
  locale          String?
  accounts        Account[]
  sessions        Session[]
  memberships     WorkspaceMember[]
  invitesSent     WorkspaceInvite[] @relation("InviteInviter")
  invitesAccepted WorkspaceInvite[] @relation("InviteAccepter")
  ideas           Idea[]
  projectsCreated VideoProject[] @relation("ProjectCreator")
  projectsOwned   VideoProject[] @relation("ProjectOwner")
  projectRoles    ProjectMember[]
  scenesSpoken    Scene[]           @relation("SceneSpeaker")
  completedChecklistItems ShootChecklistItem[]
  recordedTakes Take[]
  continuityNotes ContinuityNote[]
  assetsCreated   Asset[]
  editingAssigned EditingInfo[]
  editVersions    EditVersion[]
  reviewComments  ReviewComment[] @relation("ReviewCommentAuthor")
  reviewResolved  ReviewComment[] @relation("ReviewCommentResolver")
  approvalsRequested Approval[] @relation("ApprovalRequester")
  approvalsReviewed  Approval[] @relation("ApprovalReviewer")
  activities         ActivityLog[]
  notifications      Notification[] @relation("NotificationRecipient")
  notificationsSent  Notification[] @relation("NotificationActor")
  productionTemplates ProductionTemplate[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  logoUrl   String?
  timezone  String            @default("America/Cuiaba")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  ideas     Idea[]
  projects  VideoProject[]
  equipment EquipmentItem[]
  checklistTemplates ChecklistTemplate[]
  productionTemplates ProductionTemplate[]
  activities ActivityLog[]
  notifications Notification[]
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model WorkspaceInvite {
  id           String       @id @default(uuid())
  workspaceId  String
  email        String
  role         WorkspaceRole
  tokenHash    String       @unique
  status       InviteStatus @default(PENDING)
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation("InviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email, status])
}

enum IdeaFormat {
  TUTORIAL
  SKETCH
  DEMO
  FEATURE
  INSTITUTIONAL
  EDUCATIONAL
  BEHIND_THE_SCENES
  OTHER
}

enum IdeaStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  DISCARDED
  CONVERTED
}

model Idea {
  id           String      @id @default(uuid())
  workspaceId  String
  title        String
  description  String?
  format       IdeaFormat?
  objective    String?
  product      String?
  audience     String?
  referenceUrl String?
  notes        String?
  authorId     String
  status       IdeaStatus  @default(NEW)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  projects     VideoProject[]

  @@index([workspaceId, createdAt])
}

enum VideoProjectStatus {
  IDEA
  PRE_PRODUCTION
  SCRIPTING
  READY_TO_RECORD
  RECORDING
  EDITING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AspectRatio {
  NINE_SIXTEEN
  SIXTEEN_NINE
  ONE_ONE
  FOUR_FIVE
}

model VideoProject {
  id                        String             @id @default(uuid())
  workspaceId               String
  title                     String
  slug                      String?
  description               String?
  objective                 String?
  audience                  String?
  product                   String?
  format                    IdeaFormat
  aspectRatio               AspectRatio        @default(NINE_SIXTEEN)
  estimatedDurationSeconds  Int?
  status                    VideoProjectStatus @default(IDEA)
  priority                  ProjectPriority    @default(NORMAL)
  thumbnailUrl              String?
  ownerId                   String?
  plannedShootDate          DateTime?
  plannedPublishDate        DateTime?
  sourceIdeaId              String?
  createdById               String
  // Último número de EditVersion dado; o incremento na linha da produção
  // serializa envios simultâneos (VERSION-002).
  lastEditVersionNumber     Int                @default(0)
  deletedAt                 DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  workspace                 Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy                 User               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  owner                     User?              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sourceIdea                Idea?              @relation(fields: [sourceIdeaId], references: [id], onDelete: SetNull)
  members                   ProjectMember[]
  script                    Script?
  scenes                    Scene[]
  shoots                    Shoot[]
  continuityNotes           ContinuityNote[]
  assets                    Asset[]
  editingInfo               EditingInfo?
  editVersions              EditVersion[]
  approvals                 Approval[]
  publications              Publication[]
  checklistItems            ProjectChecklistItem[]
  activities                ActivityLog[]
  notifications             Notification[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

enum ProjectRole {
  PRODUCER
  DIRECTOR
  SCRIPT_WRITER
  PRESENTER
  CAMERA
  EDITOR
  REVIEWER
  APPROVER
  OTHER
}

model Script {
  id             String       @id @default(uuid())
  videoProjectId String       @unique
  hook           String?
  mainMessage    String?
  cta            String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
}

enum SceneType {
  HOOK
  TALKING_HEAD
  DIALOGUE
  SCREEN_CAPTURE
  BROLL
  PRODUCT
  VOICE_OVER
  CTA
  OTHER
}

enum SceneStatus {
  PLANNED
  READY
  RECORDING
  RECORDED
  NEEDS_RETAKE
  DISCARDED
}

model Scene {
  id                        String      @id @default(uuid())
  videoProjectId            String
  order                     Int
  title                     String
  description               String?
  type                      SceneType
  speakerId                 String?
  dialogue                  String?
  action                    String?
  estimatedDurationSeconds  Int?
  cameraInstructions        String?
  editingInstructions       String?
  continuityNotes           String?
  status                    SceneStatus @default(PLANNED)
  deletedAt                 DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  videoProject              VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  speaker                   User?        @relation("SceneSpeaker", fields: [speakerId], references: [id], onDelete: SetNull)
  shots                     Shot[]

  @@unique([videoProjectId, order])
  @@index([videoProjectId, status])
}

model ProjectMember {
  id             String       @id @default(uuid())
  videoProjectId String
  userId         String
  role           ProjectRole
  createdAt      DateTime     @default(now())
  project        VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoProjectId, userId, role])
  @@index([videoProjectId])
  @@index([userId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ShotType {
  CAMERA
  SCREEN_CAPTURE
  BROLL
  INSERT
  VOICE_ONLY
  OTHER
}

enum ShotStatus {
  PLANNED
  RECORDED
  NEEDS_RETAKE
  DISCARDED
}

model Shot {
  id            String     @id @default(uuid())
  sceneId       String
  order         Int
  name          String?
  cameraLabel   String?
  shotType      ShotType   @default(CAMERA)
  framing       String?
  angle         String?
  subject       String?
  movement      String?
  description   String?
  requiredTakes Int        @default(1)
  notes         String?
  status        ShotStatus @default(PLANNED)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  scene         Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  takes         Take[]

  @@unique([sceneId, order])
  @@index([sceneId, status])
}

enum ShootStatus {
  PLANNED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model Shoot {
  id             String       @id @default(uuid())
  videoProjectId String
  title          String?
  scheduledAt    DateTime
  endAt          DateTime?
  location       String?
  status         ShootStatus  @default(PLANNED)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  equipment      ShootEquipment[]
  checklist      ShootChecklistItem[]

  @@index([videoProjectId, scheduledAt])
  @@index([videoProjectId, status])
}

enum EquipmentCategory {
  CAMERA
  SMARTPHONE
  MICROPHONE
  TRIPOD
  LIGHTING
  POWER
  LAPTOP
  OTHER
}

model EquipmentItem {
  id          String            @id @default(uuid())
  workspaceId String
  name        String
  category    EquipmentCategory
  notes       String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shoots      ShootEquipment[]

  @@index([workspaceId, active])
  @@index([workspaceId, category])
}

model ShootEquipment {
  id              String        @id @default(uuid())
  shootId         String
  equipmentItemId String
  required        Boolean       @default(true)
  checked         Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  shoot           Shoot         @relation(fields: [shootId], references: [id], onDelete: Cascade)
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@unique([shootId, equipmentItemId])
  @@index([equipmentItemId])
}

enum ChecklistType {
  SHOOT
  OTHER
}

model ChecklistTemplate {
  id          String                  @id @default(uuid())
  workspaceId String
  name        String
  type        ChecklistType           @default(SHOOT)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productionTemplates ProductionTemplate[]
  items       ChecklistTemplateItem[]

  @@index([workspaceId, type])
}

model ChecklistTemplateItem {
  id                  String            @id @default(uuid())
  checklistTemplateId String
  order               Int
  text                String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  checklistTemplate   ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@unique([checklistTemplateId, order])
}

model ShootChecklistItem {
  id            String    @id @default(uuid())
  shootId       String
  text          String
  order         Int
  completed     Boolean   @default(false)
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  shoot         Shoot     @relation(fields: [shootId], references: [id], onDelete: Cascade)
  completedBy   User?     @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([shootId, order])
}

enum TakeStatus {
  OK
  RETAKE
  DISCARDED
}

model Take {
  id           String     @id @default(uuid())
  shotId       String
  number       Int
  status       TakeStatus
  notes        String?
  favorite     Boolean    @default(false)
  recordedById String?
  recordedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  shot         Shot       @relation(fields: [shotId], references: [id], onDelete: Cascade)
  recordedBy   User?      @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([shotId, number])
  @@index([shotId, status])
}

// Continuidade é texto por produção no MVP: quem aparece com o quê, onde
// fica cada objeto, como estava cada câmera. Fotos ficam para depois.
model ContinuityNote {
  id             String       @id @default(uuid())
  videoProjectId String
  category       String?
  title          String
  description    String
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([videoProjectId, category])
}

enum AssetType {
  RAW_FOOTAGE
  SCREEN_RECORDING
  REFERENCE
  AUDIO
  IMAGE
  PROJECT_FILE
  FINAL_EXPORT
  FOLDER
  OTHER
}

// Mídia pesada fica fora (ADR-006): o asset é só a referência para onde ela
// está (Drive, Dropbox, NAS, Frame.io...).
model Asset {
  id             String       @id @default(uuid())
  videoProjectId String
  type           AssetType
  title          String
  url            String
  description    String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([videoProjectId, type])
  @@index([videoProjectId, createdAt])
}

// Um registro por produção com o combinado da edição. O vídeo é editado fora
// (ADR-007); aqui fica quem edita, onde está o projeto e o formato de saída.
model EditingInfo {
  id               String       @id @default(uuid())
  videoProjectId   String       @unique
  editorId         String?
  software         String?
  projectFileUrl   String?
  notes            String?
  targetResolution String?
  targetFps        Float?
  aspectRatio      AspectRatio?
  captionsRequired Boolean      @default(false)
  musicRequired    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  videoProject     VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  editor           User?        @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@index([editorId])
}

// Cada corte enviado para revisão vira uma versão numerada por produção
// (V1, V2...). O arquivo fica fora; aqui só os links.
model EditVersion {
  id             String       @id @default(uuid())
  videoProjectId String
  versionNumber  Int
  title          String?
  previewUrl     String?
  fileUrl        String?
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  comments       ReviewComment[]
  approvals      Approval[]

  @@unique([videoProjectId, versionNumber])
}

// Comentário de revisão pertence a uma versão. O tempo no vídeo fica em
// segundos; a tela mostra MM:SS.
model ReviewComment {
  id               String      @id @default(uuid())
  editVersionId    String
  authorId         String?
  timestampSeconds Int?
  text             String
  resolved         Boolean     @default(false)
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  editVersion      EditVersion @relation(fields: [editVersionId], references: [id], onDelete: Cascade)
  author           User?       @relation("ReviewCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy       User?       @relation("ReviewCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([editVersionId, resolved])
}

enum ApprovalStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
}

// Pedido de aprovação de uma versão. A decisão muda o status da produção
// na mesma transação (APPROVED ou EDITING).
model Approval {
  id             String         @id @default(uuid())
  videoProjectId String
  editVersionId  String
  status         ApprovalStatus @default(PENDING)
  requestedById  String?
  reviewedById   String?
  notes          String?
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?
  videoProject   VideoProject   @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  editVersion    EditVersion    @relation(fields: [editVersionId], references: [id], onDelete: Cascade)
  requestedBy    User?          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy     User?          @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([videoProjectId, status])
  @@index([editVersionId, createdAt])
  // Um pedido aberto por produção, garantido pelo banco (HARDEN-008).
  @@unique([videoProjectId], map: "Approval_videoProjectId_pending_key", where: raw("status = 'PENDING'"))
}

enum Platform {
  INSTAGRAM_REELS
  TIKTOK
  YOUTUBE_SHORTS
  YOUTUBE
  LINKEDIN
  FACEBOOK
  OTHER
}

enum PublicationStatus {
  PENDING
  SCHEDULED
  PUBLISHED
  FAILED
  CANCELED
}

// Destino de publicação da produção. O sistema não publica (spec §33):
// a equipe registra horário, link e status à mão.
model Publication {
  id             String            @id @default(uuid())
  videoProjectId String
  platform       Platform
  status         PublicationStatus @default(PENDING)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  url            String?
  caption        String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  videoProject   VideoProject      @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)

  @@index([videoProjectId, status])
  @@index([scheduledAt])
}

// Modelo de produção do workspace. Criar produção por template copia a
// estrutura; nada fica ligado ao template depois (TEMPLATE-004).
model ProductionTemplate {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  description String?
  // Checklist de gravação sugerido; a produção recebe cópia dos itens.
  checklistTemplateId String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  scenes      ProductionTemplateScene[]

  @@index([workspaceId, name])
}

// Cena-modelo: só a estrutura (ordem, título, tipo, descrição). Vira Scene
// de verdade quando a produção é criada pelo template.
model ProductionTemplateScene {
  id          String             @id @default(uuid())
  templateId  String
  order       Int
  title       String
  type        SceneType
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  template    ProductionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
}

// Cópia dos itens do checklist do template na criação da produção. Mudar o
// checklist ou o template depois não altera a produção (TEMPLATE-004).
model ProjectChecklistItem {
  id             String       @id @default(uuid())
  videoProjectId String
  order          Int
  text           String
  createdAt      DateTime     @default(now())
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)

  @@unique([videoProjectId, order])
}

// Registro de negócio, não log técnico (AGENTS §19). `action` é validada no
// serviço contra a lista fechada de activity-labels.ts.
model ActivityLog {
  id             String        @id @default(uuid())
  workspaceId    String
  videoProjectId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  videoProject   VideoProject? @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([videoProjectId, createdAt])
}

// Aviso interno para uma pessoa (spec §40). Sem push no MVP. `type` é
// validado no serviço contra a lista fechada de notification-labels.ts.
model Notification {
  id             String        @id @default(uuid())
  workspaceId    String
  userId         String
  actorId        String?
  videoProjectId String?
  type           String
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  videoProject   VideoProject? @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, readAt])
  @@index([userId, workspaceId, createdAt])
}
