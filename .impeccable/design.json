      "css": ".ds-btn-primary{display:inline-flex;align-items:center;height:44px;padding:0 12px;border:1px solid transparent;border-radius:4px;background:var(--primary,#2d5ea8);color:var(--primary-foreground,#fafbfd);font:500 14px 'IBM Plex Sans',sans-serif;cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary,#2d5ea8) 80%,transparent)}.ds-btn-primary:focus-visible{outline:none;border-color:var(--ring,#2f6fc0);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,#2f6fc0) 50%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}"
