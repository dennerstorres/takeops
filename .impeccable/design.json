      "css": ".ds-board{background:var(--frame,#c4c7cc);border-radius:3.2px;padding:4px;color:var(--strip-ink,#1f2328);font-family:'IBM Plex Sans',sans-serif}.ds-board ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1px}.ds-divider{display:flex;height:24px;align-items:center;justify-content:space-between;padding:0 8px;border-radius:2px;background:var(--divider,#1b1d21);color:var(--divider-foreground,#f4f3ef);font-family:'IBM Plex Sans Condensed',sans-serif;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase}.ds-strip{display:grid;grid-template-columns:44px 64px minmax(0,1fr) 144px 96px 8px;column-gap:10px;align-items:center;min-height:28px;padding:0 6px 0 8px;border-radius:2px;background:var(--strip-set,#f1e3a4);transition:filter .15s}.ds-strip:hover{filter:brightness(.96)}.ds-strip:focus-within{outline:2px solid var(--ring,#2f6fc0);outline-offset:-2px}.ds-code{align-self:stretch;display:flex;align-items:center;border-right:1px solid rgba(0,0,0,.15);font-family:'IBM Plex Sans Condensed',sans-serif;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase}.ds-title{font-size:14px;font-weight:500;color:inherit;text-decoration:none;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;outline:none}.ds-meta{font-family:'IBM Plex Sans Condensed',sans-serif;font-size:12px;color:var(--strip-ink-muted,#50555c);font-variant-numeric:tabular-nums}.ds-tip{width:8px;height:16px;justify-self:end;box-shadow:inset 0 0 0 1px var(--strip-ink,#1f2328);background:repeating-linear-gradient(135deg,var(--strip-ink,#1f2328) 0 2px,transparent 2px 5px)}"
    },
    {
